library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity tb_tcp_server is
    -- Testbench nema portove
end entity;

architecture simulacija of tb_tcp_server is

    -- 1. Deklaracija komponente koju testiramo (DUT - Device Under Test)
    component tcp_server is
        generic (
            SERVER_PORT : std_logic_vector(15 downto 0) := x"1F90" -- 8080
        );
        port (
            clock        : in  std_logic;
            reset        : in  std_logic;
            is_connected : out std_logic;
            client_mac   : out std_logic_vector(47 downto 0);
            client_ip    : out std_logic_vector(31 downto 0);
            client_port  : out std_logic_vector(15 downto 0);
            in_data      : in  std_logic_vector(7 downto 0);
            in_valid     : in  std_logic;
            in_sop       : in  std_logic;
            in_eop       : in  std_logic;
            in_ready     : out std_logic;
            out_data     : out std_logic_vector(7 downto 0);
            out_valid    : out std_logic;
            out_sop      : out std_logic;
            out_eop      : out std_logic;
            out_ready    : in  std_logic
        );
    end component;

    -- 2. Signali za povezivanje
    signal takt          : std_logic := '0';
    signal reset         : std_logic := '0';
    
    -- RX Signali (Klijent -> Server)
    signal tb_in_data    : std_logic_vector(7 downto 0) := (others => '0');
    signal tb_in_valid   : std_logic := '0';
    signal tb_in_sop     : std_logic := '0';
    signal tb_in_eop     : std_logic := '0';
    signal tb_in_ready   : std_logic; -- Izlaz iz servera
    
    -- TX Signali (Server -> Klijent)
    signal tb_out_data   : std_logic_vector(7 downto 0);
    signal tb_out_valid  : std_logic;
    signal tb_out_sop    : std_logic;
    signal tb_out_eop    : std_logic;
    signal tb_out_ready  : std_logic := '1'; -- Simuliramo da je mre?a spremna
    
    -- Statusni signali
    signal tb_is_connected : std_logic;
    signal tb_client_mac   : std_logic_vector(47 downto 0);
    signal tb_client_ip    : std_logic_vector(31 downto 0);
    signal tb_client_port  : std_logic_vector(15 downto 0);

    -- Konstante
    constant PERIOD_TAKTA : time := 10 ns; -- 100 MHz
    
    -- Podaci klijenta za testiranje (prema tvom wavedromu)
    -- MAC: aa:bb:cc:00:01:10
    -- IP: 192.168.12.1 (C0 A8 0C 01)
    -- Port: 8080 (1F 90) *Napomena: U ovom modelu servera, klijent mora ga?ati port 8080 
    -- da bi bio prihva?en, pa to ?aljemo kao destinaciju.

begin

    -- 3. Instanciranje (DUT)
    DUT: tcp_server
    generic map (
        SERVER_PORT => x"1F90"
    )
    port map (
        clock        => takt,
        reset        => reset,
        is_connected => tb_is_connected,
        client_mac   => tb_client_mac,
        client_ip    => tb_client_ip,
        client_port  => tb_client_port,
        in_data      => tb_in_data,
        in_valid     => tb_in_valid,
        in_sop       => tb_in_sop,
        in_eop       => tb_in_eop,
        in_ready     => tb_in_ready,
        out_data     => tb_out_data,
        out_valid    => tb_out_valid,
        out_sop      => tb_out_sop,
        out_eop      => tb_out_eop,
        out_ready    => tb_out_ready
    );

    -- 4. Generisanje takta
    process
    begin
        takt <= '0';
        wait for PERIOD_TAKTA / 2;
        takt <= '1';
        wait for PERIOD_TAKTA / 2;
    end process;

    -- 5. Glavni proces stimulacije (Scenario)
    process
        -- Procedura za slanje paketa kako bi kod bio ?itljiviji
        procedure posalji_paket(
            tip_paketa : string; -- "SYN" ili "ACK"
            duzina     : integer
        ) is 
        begin
            report "--> Slanje paketa: " & tip_paketa;
            
            for i in 0 to duzina-1 loop
                wait until rising_edge(takt);
                tb_in_valid <= '1';
                
                -- Upravljanje SOP (Start) i EOP (End) signalima
                if i = 0 then tb_in_sop <= '1'; else tb_in_sop <= '0'; end if;
                if i = duzina-1 then tb_in_eop <= '1'; else tb_in_eop <= '0'; end if;

                -- Generisanje podataka zavisno od pozicije (bajta)
                case i is
                    -- Ethernet Header: Source MAC (aa:bb:cc:00:01:10)
                    when 6  => tb_in_data <= x"AA";
                    when 7  => tb_in_data <= x"BB";
                    when 8  => tb_in_data <= x"CC";
                    when 9  => tb_in_data <= x"00";
                    when 10 => tb_in_data <= x"01";
                    when 11 => tb_in_data <= x"10";

                    -- IP Header: Source IP (192.168.12.1 -> C0.A8.0C.01)
                    when 26 => tb_in_data <= x"C0";
                    when 27 => tb_in_data <= x"A8";
                    when 28 => tb_in_data <= x"0C";
                    when 29 => tb_in_data <= x"01";

                    -- TCP Header: Port (Mora biti x1F90 da bi server prihvatio vezu)
                    when 34 => tb_in_data <= x"1F";
                    when 35 => tb_in_data <= x"90";

                    -- TCP Flags (Bajt 47)
                    when 47 => 
                        if tip_paketa = "SYN" then
                            tb_in_data <= x"02"; -- SYN bit (0000 0010)
                        elsif tip_paketa = "ACK" then
                            tb_in_data <= x"10"; -- ACK bit (0001 0000)
                        else
                            tb_in_data <= x"00";
                        end if;

                    -- Ostali podaci (Payload/Padding)
                    when others => tb_in_data <= x"00";
                end case;
            end loop;

            -- Kraj paketa
            wait until rising_edge(takt);
            tb_in_valid <= '0';
            tb_in_sop   <= '0';
            tb_in_eop   <= '0';
            tb_in_data  <= (others => '0');
            report "--> Paket zavrsen.";
        end procedure;

    begin
        -- =========================================================
        -- KORAK 0: Inicijalizacija i Reset
        -- =========================================================
        wait for 50 ns;
        reset <= '1';
        wait for 50 ns;
        reset <= '0';
        wait for 50 ns;
        
        report "STANJE: Server bi trebao biti u LISTEN.";

        -- =========================================================
        -- KORAK 1: Klijent ?alje SYN (Wavedrom 1)
        -- =========================================================
        -- ?aljemo paket du?ine 64 bajta sa SYN zastavicom
        posalji_paket("SYN", 64);

        -- =========================================================
        -- KORAK 2: Server ?alje SYN-ACK (Provjera odgovora)
        -- =========================================================
        -- ?ekamo da server obradi paket i po?ne slati odgovor
        wait until tb_out_valid = '1'; 
        report "STANJE: Detektovan odgovor od servera (trebao bi biti SYN-ACK).";
        
        -- ?ekamo kraj tog paketa
        wait until tb_out_eop = '1';
        wait for 20 ns; -- Mali razmak
        
        report "STANJE: Server bi trebao biti u SYN_RCVD.";

        -- =========================================================
        -- KORAK 3: Klijent ?alje ACK (Wavedrom 2)
        -- =========================================================
        wait for 100 ns; -- Simuliramo ka?njenje mre?e
        posalji_paket("ACK", 64);

        -- =========================================================
        -- KORAK 4: Provjera uspostavljene veze (Wavedrom 3 - kraj)
        -- =========================================================
        wait for 50 ns;
        
        if tb_is_connected = '1' then
            report "USPJESNO: Veza uspostavljena (is_connected = 1)!";
        else
            report "GRESKA: Veza NIJE uspostavljena.";
        end if;

        -- Provjera uhva?enih podataka
        if tb_client_mac = x"aabbcc000110" then
            report "MAC Adresa: ISPRAVNA";
        else 
            report "MAC Adresa: POGRESNA";
        end if;

        if tb_client_ip = x"C0A80C01" then
            report "IP Adresa: ISPRAVNA (192.168.12.1)";
        else
            report "IP Adresa: POGRESNA";
        end if;

        wait; -- Kraj simulacije
    end process;

end architecture;